---
import "../styles/global.css";

type Props = {
	title: string;
	description: string;
	preloadDisplayFont?: boolean;
};

const { title, description, preloadDisplayFont = false } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isGettingStartedPage = pathname === "/getting-started";
---

<!doctype html>
<html lang="en" class="scheme-dark" data-page={pathname === "/" ? "home" : "guide"}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		{preloadDisplayFont && (
			<link
				rel="preload"
				href="/fonts/upheaval.woff2"
				as="font"
				type="font/woff2"
				crossorigin
			/>
		)}
		<meta name="color-scheme" content="dark" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot name="skip" />
		<header class="site-header">
			<a href="/" class="site-brand" aria-label="Platinum Gold home">
				<span class="site-brand-mark" aria-hidden="true"></span>
				<span>Platinum Gold</span>
			</a>
			<nav class="site-nav" aria-label="Primary">
				<a href="/getting-started" aria-current={isGettingStartedPage ? "page" : undefined}>
					Getting started
				</a>
				<a href="https://platinum-gold-backend.vercel.app/docs">API reference</a>
				<a href="https://platinum-gold-backend.vercel.app/openapi.json">OpenAPI</a>
			</nav>
		</header>
		<slot />
	</body>
</html>
