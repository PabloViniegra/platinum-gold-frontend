---
import "../styles/global.css";

type Props = {
	title: string;
	description: string;
	preloadDisplayFont?: boolean;
};

const { title, description, preloadDisplayFont = false } = Astro.props;
const isGettingStartedPage = Astro.url.pathname.replace(/\/+$/, "") === "/getting-started";
---

<!doctype html>
<html lang="en" class="scheme-dark">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		{preloadDisplayFont && (
			<link
				rel="preload"
				href="/fonts/upheaval.woff2"
				as="font"
				type="font/woff2"
				crossorigin
			/>
		)}
		<meta name="color-scheme" content="dark" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot name="skip" />
		<header
			class="bg-surface sticky top-0 z-40 flex min-h-12 flex-wrap items-center justify-between gap-x-lg border-b border-border px-margin"
		>
			<a
				href="/"
				class="font-sans text-body-md font-semibold tracking-[-0.02em] text-on-surface hover:text-on-surface"
				>Platinum Gold</a
			>
			{!isGettingStartedPage && (
				<nav aria-label="Primary">
					<a
						href="/getting-started"
						class="inline-flex min-h-11 items-center font-sans text-body-md font-semibold"
						>Start the first call</a
					>
				</nav>
			)}
		</header>
		<slot />
	</body>
</html>
