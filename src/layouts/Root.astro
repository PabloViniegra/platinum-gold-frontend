---
import { ApiKeyRequestDialog } from "../components/ApiKeyRequestDialog";
import { HERO_WALL_AVIF_SRC, HERO_WALL_AVIF_SRCSET, HERO_WALL_WEBP_LG_SRC } from "../lib/hero-wall";
import { canonicalPageUrl, pageJsonLd } from "../lib/seo";
import "../styles/global.css";

type Props = {
	title: string;
	description: string;
	preloadDisplayFont?: boolean;
	noindex?: boolean;
};

const { title, description, preloadDisplayFont = false, noindex = false } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isGettingStartedPage = pathname === "/getting-started";
const isItemsPage = pathname === "/items";
const isAdminPage = pathname.startsWith("/admin");
const site = Astro.site;
const canonicalHref = site ? canonicalPageUrl(site.href, pathname) : undefined;
const ogImageHref = site ? new URL(HERO_WALL_WEBP_LG_SRC, site).href : undefined;
const crumbName = isGettingStartedPage ? "Getting started" : isItemsPage ? "Live example" : title;
---

<!doctype html>
<html lang="en" class="scheme-dark" data-page={pathname === "/" ? "home" : isItemsPage ? "items" : "guide"}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{!isAdminPage && (
			<link
				rel="preload"
				as="image"
				type="image/avif"
				href={HERO_WALL_AVIF_SRC}
				imagesrcset={HERO_WALL_AVIF_SRCSET}
				imagesizes="100vw"
				fetchpriority="high"
			/>
		)}
		{preloadDisplayFont && (
			<link
				rel="preload"
				href="/fonts/upheaval.woff2"
				as="font"
				type="font/woff2"
				crossorigin
			/>
		)}
		<meta name="color-scheme" content="dark" />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{!noindex && site && canonicalHref && ogImageHref && (
			<>
				<link rel="canonical" href={canonicalHref} />
				<link rel="sitemap" href="/sitemap-index.xml" />
				<meta property="og:site_name" content="Platinum Gold" />
				<meta property="og:locale" content="en_US" />
				<meta property="og:type" content="website" />
				<meta property="og:title" content={title} />
				<meta property="og:description" content={description} />
				<meta property="og:url" content={canonicalHref} />
				<meta property="og:image" content={ogImageHref} />
				<meta property="og:image:alt" content="Basement wall from The Binding of Isaac" />
				<meta name="twitter:card" content="summary_large_image" />
				<meta name="twitter:title" content={title} />
				<meta name="twitter:description" content={description} />
				<meta name="twitter:image" content={ogImageHref} />
				<script is:inline type="application/ld+json" set:html={pageJsonLd(site.href, canonicalHref, title, description, crumbName)} />
			</>
		)}
		<slot name="head" />
	</head>
	<body>
		<slot name="skip" />
		<header class="site-header">
			<a href="/" class="site-brand" aria-label="Platinum Gold home">
				<span class="site-brand-mark" aria-hidden="true"></span>
				<span>Platinum Gold</span>
			</a>
			<nav class="site-nav" aria-label="Primary">
				<a href="/getting-started" aria-current={isGettingStartedPage ? "page" : undefined}>
					Getting started
				</a>
				<a href="/items" aria-current={isItemsPage ? "page" : undefined}>Live example</a>
				<a href="https://platinum-gold-backend.vercel.app/docs">API reference</a>
				<a href="https://platinum-gold-backend.vercel.app/openapi.json">OpenAPI</a>
				{!isAdminPage && <ApiKeyRequestDialog client:idle placement="nav" />}
			</nav>
		</header>
		<slot />
		{!isAdminPage && (
			<script>
				document.addEventListener("click", (event) => {
					if (!(event.target instanceof Element)) {
						return;
					}
					const opener = event.target.closest("[data-open-request-access]");
					if (!(opener instanceof HTMLElement)) {
						return;
					}
					const accessEvent = new CustomEvent("pg:request-access", { cancelable: true, detail: opener });
					document.dispatchEvent(accessEvent);
					if (!accessEvent.defaultPrevented) {
						document.documentElement.dataset.pgOpenRequest = "";
					}
				});
			</script>
		)}
	</body>
</html>
