---
import { ApiKeyRequestDialog } from "../components/ApiKeyRequestDialog";
import "../styles/global.css";

type Props = {
	title: string;
	description: string;
	preloadDisplayFont?: boolean;
	noindex?: boolean;
};

const { title, description, preloadDisplayFont = false, noindex = false } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isGettingStartedPage = pathname === "/getting-started";
const isItemsPage = pathname === "/items";
const isAdminPage = pathname.startsWith("/admin");
---

<!doctype html>
<html lang="en" class="scheme-dark" data-page={pathname === "/" ? "home" : isItemsPage ? "items" : "guide"}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{!isAdminPage && (
			<link
				rel="preload"
				as="image"
				href="/tboi-wall.webp"
				imagesrcset="/tboi-wall.webp 1280w, /tboi-wall-lg.webp 1920w"
				imagesizes="100vw"
				fetchpriority="high"
			/>
		)}
		{preloadDisplayFont && (
			<link
				rel="preload"
				href="/fonts/upheaval.woff2"
				as="font"
				type="font/woff2"
				crossorigin
			/>
		)}
		<meta name="color-scheme" content="dark" />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<slot name="head" />
	</head>
	<body>
		<slot name="skip" />
		<header class="site-header">
			<a href="/" class="site-brand" aria-label="Platinum Gold home">
				<span class="site-brand-mark" aria-hidden="true"></span>
				<span>Platinum Gold</span>
			</a>
			<nav class="site-nav" aria-label="Primary">
				<a href="/getting-started" aria-current={isGettingStartedPage ? "page" : undefined}>
					Getting started
				</a>
				<a href="/items" aria-current={isItemsPage ? "page" : undefined}>Live example</a>
				<a href="https://platinum-gold-backend.vercel.app/docs">API reference</a>
				<a href="https://platinum-gold-backend.vercel.app/openapi.json">OpenAPI</a>
				{!isAdminPage && <ApiKeyRequestDialog client:idle placement="nav" />}
			</nav>
		</header>
		<slot />
		{!isAdminPage && (
			<script>
				document.addEventListener("click", (event) => {
					if (!(event.target instanceof Element)) {
						return;
					}
					const opener = event.target.closest("[data-open-request-access]");
					if (!(opener instanceof HTMLElement)) {
						return;
					}
					const accessEvent = new CustomEvent("pg:request-access", { cancelable: true, detail: opener });
					document.dispatchEvent(accessEvent);
					if (!accessEvent.defaultPrevented) {
						document.documentElement.dataset.pgOpenRequest = "";
					}
				});
			</script>
		)}
	</body>
</html>
