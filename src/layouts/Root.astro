---
import sourceSans400 from "@fontsource/source-sans-3/files/source-sans-3-latin-400-normal.woff2?url";
import sourceSans600 from "@fontsource/source-sans-3/files/source-sans-3-latin-600-normal.woff2?url";

import { REQUESTS_PUBLIC_ENABLED } from "astro:env/server";
import { ApiKeyRequestDialog } from "../components/ApiKeyRequestDialog";
import {
	HERO_WALL_AVIF_SRC,
	HERO_WALL_AVIF_SRCSET,
	HERO_WALL_WEBP_LG_HEIGHT,
	HERO_WALL_WEBP_LG_SRC,
	HERO_WALL_WEBP_LG_WIDTH,
} from "../lib/hero-wall";
import { canonicalPageUrl, pageJsonLd } from "../lib/seo";
import "../styles/global.css";

type Props = {
	title: string;
	description: string;
	preloadDisplayFont?: boolean;
	noindex?: boolean;
	language?: "en" | "es";
};

const { title, description, preloadDisplayFont = false, noindex = false, language = "en" } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isGettingStartedPage = pathname === "/getting-started";
const isItemsPage = pathname === "/items";
const legalPath = pathname.startsWith("/es/") ? pathname.slice(3) : pathname;
const isLegalPage = ["/privacy", "/terms", "/legal", "/cookies", "/licenses"].includes(legalPath);
const isAdminPage = pathname.startsWith("/admin");
const site = Astro.site;
const canonicalHref = site ? canonicalPageUrl(site.href, pathname) : undefined;
const ogImageHref = site ? new URL(HERO_WALL_WEBP_LG_SRC, site).href : undefined;
const crumbName = isGettingStartedPage ? "Getting started" : isItemsPage ? "Live example" : title;
const isSpanish = language === "es";
---

<!doctype html>
<html lang={language} class="scheme-dark" data-page={pathname === "/" ? "home" : isItemsPage ? "items" : isLegalPage ? "legal" : "guide"}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="oklch(0.145 0.025 52)" />
		<link rel="preload" href={sourceSans400} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={sourceSans600} as="font" type="font/woff2" crossorigin />
		{!isAdminPage && !isLegalPage && (
			<link
				rel="preload"
				as="image"
				type="image/avif"
				href={HERO_WALL_AVIF_SRC}
				imagesrcset={HERO_WALL_AVIF_SRCSET}
				imagesizes="100vw"
				fetchpriority="high"
			/>
		)}
		{preloadDisplayFont && (
			<link
				rel="preload"
				href="/fonts/upheaval.woff2"
				as="font"
				type="font/woff2"
				crossorigin
			/>
		)}
		<meta name="color-scheme" content="dark" />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{!noindex && site && canonicalHref && ogImageHref && (
			<>
				<link rel="canonical" href={canonicalHref} />
				<link rel="sitemap" href="/sitemap-index.xml" />
				<meta property="og:site_name" content="Platinum Gold" />
				<meta property="og:locale" content="en_US" />
				<meta property="og:type" content="website" />
				<meta property="og:title" content={title} />
				<meta property="og:description" content={description} />
				<meta property="og:url" content={canonicalHref} />
				<meta property="og:image" content={ogImageHref} />
				<meta property="og:image:alt" content="Basement wall from The Binding of Isaac" />
				<meta property="og:image:type" content="image/webp" />
				<meta property="og:image:width" content={String(HERO_WALL_WEBP_LG_WIDTH)} />
				<meta property="og:image:height" content={String(HERO_WALL_WEBP_LG_HEIGHT)} />
				<meta name="twitter:card" content="summary_large_image" />
				<meta name="twitter:title" content={title} />
				<meta name="twitter:description" content={description} />
				<meta name="twitter:image" content={ogImageHref} />
				<meta name="twitter:image:alt" content="Basement wall from The Binding of Isaac" />
				<script is:inline type="application/ld+json" set:html={pageJsonLd(site.href, canonicalHref, title, description, crumbName)} />
			</>
		)}
		<slot name="head" />
	</head>
	<body>
		<slot name="skip" />
		<header class="site-header">
			<a href="/" class="site-brand" aria-label={isSpanish ? "Inicio de Platinum Gold" : "Platinum Gold home"}>
				<span class="site-brand-mark" aria-hidden="true"></span>
				<span translate="no">Platinum Gold</span>
			</a>
			<nav class="site-nav" aria-label={isSpanish ? "Principal" : "Primary"}>
				<a href="/getting-started" aria-current={isGettingStartedPage ? "page" : undefined}>
					{isSpanish ? "Guía de integración" : "Getting started"}
				</a>
				<a href="/items" aria-current={isItemsPage ? "page" : undefined}>{isSpanish ? "Ejemplo en vivo" : "Live example"}</a>
				<details class="site-nav-reference">
					<summary>{isSpanish ? "Referencia" : "Reference"}</summary>
					<div class="site-nav-reference-menu">
						<a href="https://tboi-api.pabloviniegra.dev/docs">{isSpanish ? "Referencia del API" : "API reference"}</a>
						<a href="https://tboi-api.pabloviniegra.dev/openapi.json">OpenAPI</a>
					</div>
				</details>
				{!isAdminPage && REQUESTS_PUBLIC_ENABLED && <ApiKeyRequestDialog client:idle placement="nav" legalLanguage={language} />}
				{!isAdminPage && !REQUESTS_PUBLIC_ENABLED && <span class="site-nav-paused">{isSpanish ? "Solicitudes de acceso al API pausadas" : "API access paused"}</span>}
			</nav>
		</header>
		<slot />
		{!isAdminPage && REQUESTS_PUBLIC_ENABLED && (
			<script>
				document.addEventListener("click", (event) => {
					if (!(event.target instanceof Element)) {
						return;
					}
					const opener = event.target.closest("[data-open-request-access]");
					if (!(opener instanceof HTMLElement)) {
						return;
					}
					const accessEvent = new CustomEvent("pg:request-access", { cancelable: true, detail: opener });
					document.dispatchEvent(accessEvent);
					if (!accessEvent.defaultPrevented) {
						document.documentElement.dataset.pgOpenRequest = "";
					}
				});
			</script>
		)}
		{!isAdminPage && (
			<footer class="site-footer px-margin" aria-label={isSpanish ? "Pie de página" : "Site footer"}>
				<div class="site-footer-inner">
					<nav class="site-footer-links" aria-label={isSpanish ? "Enlaces del sitio" : "Site links"}>
						<a href="/">Platinum Gold</a>
						<a href="/getting-started">{isSpanish ? "Guía de integración" : "Integration guide"}</a>
						<a href="/items">{isSpanish ? "Ejemplo en vivo" : "Live example"}</a>
						<a href="https://tboi-api.pabloviniegra.dev/docs">{isSpanish ? "Referencia del API" : "API reference"}</a>
					</nav>
					<nav class="site-footer-links" aria-label={isSpanish ? "Información legal" : "Legal information"}>
						<a href={isSpanish ? "/es/privacy" : "/privacy"}>{isSpanish ? "Aviso de privacidad (borrador)" : "Privacy notice (draft)"}</a>
						<a href={isSpanish ? "/es/terms" : "/terms"}>{isSpanish ? "Términos del API (borrador)" : "API terms (draft)"}</a>
						<a href={isSpanish ? "/es/legal" : "/legal"}>{isSpanish ? "Aviso legal (borrador)" : "Legal notice (draft)"}</a>
						<a href={isSpanish ? "/es/cookies" : "/cookies"}>{isSpanish ? "Cookies (borrador)" : "Cookies (draft)"}</a>
						<a href={isSpanish ? "/es/licenses" : "/licenses"}>{isSpanish ? "Licencias y atribuciones (borrador)" : "Licences and attributions (draft)"}</a>
					</nav>
					<p class="site-footer-draft">
						{isSpanish
							? "Los documentos legales marcados como borradores no están listos para publicarse."
							: "Legal documents marked as drafts are not ready for publication."}
					</p>
				</div>
			</footer>
		)}
	</body>
</html>

<style is:global>
	.site-footer {
		position: relative;
		z-index: 1;
		max-inline-size: 92rem;
		margin-inline: auto;
		padding-block: var(--spacing-xxl) max(var(--spacing-xxl), env(safe-area-inset-bottom, 0px));
	}

	.site-footer-inner {
		display: grid;
		gap: var(--spacing-lg);
		border-block-start: 1px solid var(--color-border);
		padding-block-start: var(--spacing-lg);
		color: var(--color-on-surface-muted);
		font-size: var(--text-body-sm);
	}

	.site-footer-links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-sm) var(--spacing-lg);
	}

	.site-footer-links a {
		text-underline-offset: 0.18em;
	}

	.site-footer-draft {
		max-inline-size: 65ch;
		color: var(--color-tertiary);
	}

	.site-nav-paused {
		display: inline-flex;
		min-block-size: 2.75rem;
		align-items: center;
		color: var(--color-on-surface-muted);
		font-size: var(--text-body-sm);
		font-weight: 600;
		white-space: normal;
	}

	@media (max-width: 40rem) {
		.site-nav-paused {
			grid-column: 1 / -1;
			justify-self: start;
		}
	}
</style>
