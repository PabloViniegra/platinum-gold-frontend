		box-shadow: 0.25rem 0.3rem 0 var(--color-paper-border);
	}

	.guide-table caption,
	.guide-code figcaption {
		color: var(--color-ink-muted);
	}

	.guide-table th,
	.guide-table td {
		border-color: var(--color-paper-border);
	}

	.guide-table th {
		color: var(--color-ink);
	}

	.guide-code {
		border: 1px solid var(--color-border);
		background: var(--color-surface-raised);
		box-shadow: 0.4rem 0.45rem 0 color-mix(in oklch, var(--color-paper-border) 72%, transparent);
	}

	.guide-code figcaption {
		margin: 0;
		padding: var(--spacing-sm) var(--spacing-md);
		color: var(--color-on-surface-muted);
	}

	.guide-code pre {
		margin: 0;
		border-block-start: 1px solid var(--color-border);
		border-radius: 0;
		background: var(--color-surface);
	}

	.guide-copy {
		border-color: var(--color-border);
		color: var(--color-on-surface);
	}

	@media (hover: hover) and (pointer: fine) {
		.guide-copy:hover {
			background: var(--color-primary);
			color: var(--color-on-primary);
		}
	}

	.guide-copy.is-copied {
		background: var(--color-primary);
		border-color: var(--color-primary);
		color: var(--color-on-primary);
	}

	@media (max-width: 48rem) {
		.guide-header h1 {
			font-size: clamp(2.75rem, 15vw, 5rem);
			overflow-wrap: normal;
			word-break: normal;
		}

		.guide-start {
			grid-template-columns: minmax(0, 1fr);
		}

		.guide-path {
			grid-template-columns: 1fr;
		}

		.guide-path li:has(.guide-access-entry) {
			grid-column: auto;
		}

		.guide-layout {
			grid-template-columns: 1fr;
			gap: var(--spacing-xl);
		}

		.guide-toc {
			position: static;
			max-block-size: none;
		}

		.guide-toc ul {
			display: grid;
			gap: var(--spacing-xs);
		}

		.guide-code-hint {
			display: inline;
		}

		.guide-article {
			padding-inline: var(--spacing-md);
			box-shadow: 0.4rem 0.5rem 0 var(--pg-paper-shadow);
		}

		.guide-article h2,
		.guide-reference-heading h2 {
			font-size: clamp(2rem, 7vw, 2.25rem);
			overflow-wrap: break-word;
			word-break: normal;
		}

		.guide-article::before,
		.guide-article::after {
			display: none;
		}

		.guide-next-actions {
			flex-direction: column;
		}

		.guide-next-primary,
		.guide-next-secondary {
			justify-content: center;
		}
	}

	@media (hover: hover) and (pointer: fine) {
		.guide-path li:hover {
			border-color: var(--color-primary);
			background: var(--color-surface-raised);
		}

		.guide-path a:hover,
		.guide-path-action:hover {
			color: var(--color-primary-hover);
		}
	}

	.guide-path li:has(.guide-access-entry),
	.guide-path li:has(a[aria-current="location"]) {
		border-color: var(--color-tertiary);
		background: var(--color-surface-raised);
	}

	.guide-path li:has(:is(a, button):focus-visible) {
		border-color: var(--color-primary);
		background: var(--color-surface-raised);
	}

	.guide-copy:active,
	.guide-path li:has(:is(a, button):active),
	.guide-access-action:active,
	.guide-next-primary:active,
	.guide-next-secondary:active {
		transform: scale(0.97);
	}

	@media (prefers-reduced-motion: no-preference) {
		.guide-copy {
			transition:
				background-color 120ms ease,
				border-color 120ms ease,
				color 120ms ease,
				transform 100ms cubic-bezier(0.16, 1, 0.3, 1);
		}

		.guide-path li,
		.guide-access-action,
		.guide-next-primary,
		.guide-next-secondary {
			transition: transform 100ms cubic-bezier(0.16, 1, 0.3, 1);
		}

		.guide-copy:active {
			transition:
				background-color 120ms ease,
				border-color 120ms ease,
				color 120ms ease,
				transform 160ms cubic-bezier(0.16, 1, 0.3, 1);
		}

		.guide-path li:has(:is(a, button):active),
		.guide-access-action:active,
		.guide-next-primary:active,
		.guide-next-secondary:active {
			transition-duration: 160ms;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.guide-copy:active,
		.guide-path li:has(:is(a, button):active),
		.guide-access-action:active,
		.guide-next-primary:active,
		.guide-next-secondary:active {
			transform: none;
		}
	}

	@media (prefers-reduced-transparency: reduce) {
		.guide-start,
		.guide-toc {
			background: var(--color-surface-raised);
			backdrop-filter: none;
		}
	}
</style>

<script>
	const guideToc = document.querySelector("[data-guide-toc]");
	const guideReference = document.querySelector("[data-guide-reference]");
	const guideReferenceContent = document.querySelector("[data-guide-reference-content]");
	const guideReferenceOpener = document.querySelector("[data-open-reference]");
	const tocLinks = guideToc?.querySelectorAll<HTMLAnchorElement>("[data-toc-link]") ?? [];
	const pathLinks = document.querySelectorAll<HTMLAnchorElement>(".guide-path a");
	let activeSectionId = "";

	function setActiveSection(id: string): void {
		let activeLink: HTMLAnchorElement | undefined;
		if (id === activeSectionId) {
			return;
		}
		activeSectionId = id;
		for (const link of tocLinks) {
			if (link.hash === `#${id}`) {
				link.setAttribute("aria-current", "location");
				activeLink = link;
			} else {
				link.removeAttribute("aria-current");
			}
		}

		for (const link of pathLinks) {
			if (link.hash === `#${id}`) {
				link.setAttribute("aria-current", "location");
			} else {
				link.removeAttribute("aria-current");
			}
		}

		if (activeLink && guideReference instanceof HTMLDetailsElement && guideReference.contains(activeLink)) {
			guideReference.open = true;
		}
		const activeTarget = document.getElementById(id);
		if (activeTarget && guideReferenceContent instanceof HTMLDetailsElement
			&& guideReferenceContent.contains(activeTarget)) {
			guideReferenceContent.open = true;
		}
	}

	const tocTargets = Array.from(tocLinks)
		.map((link) => document.getElementById(link.hash.slice(1)))
		.filter((target): target is HTMLElement => target instanceof HTMLElement);

	tocLinks.forEach((link) => {
		link.addEventListener("click", () => {
			const target = document.getElementById(link.hash.slice(1));
			if (target && guideReferenceContent instanceof HTMLDetailsElement
				&& guideReferenceContent.contains(target)) {
				guideReferenceContent.open = true;
			}
		});
	});

	guideReferenceOpener?.addEventListener("click", () => {
		if (guideReferenceContent instanceof HTMLDetailsElement) {
			guideReferenceContent.open = true;
		}
	});

	function setActiveFromViewport(): void {
		if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
			setActiveSection(tocTargets[tocTargets.length - 1]?.id ?? "");
			return;
		}

		const visibleTarget = tocTargets
			.filter((target) => {
				const bounds = target.getBoundingClientRect();
				return bounds.top <= window.innerHeight * 0.35 && bounds.bottom > window.innerHeight * 0.15;
			})
			.sort((first, second) => second.getBoundingClientRect().top - first.getBoundingClientRect().top)[0];

		if (visibleTarget instanceof HTMLElement) {
			setActiveSection(visibleTarget.id);
		}
	}

	if (tocTargets.length > 0) {
		const initialTarget = document.getElementById(window.location.hash.slice(1));
		const sectionTarget = initialTarget instanceof HTMLElement && tocTargets.includes(initialTarget)
			? initialTarget
			: tocTargets[0];
		setActiveSection(sectionTarget.id);
		window.addEventListener("scroll", setActiveFromViewport, { passive: true });
		setActiveFromViewport();
	}

	window.addEventListener("hashchange", () => {
		const target = document.getElementById(window.location.hash.slice(1));
		if (target instanceof HTMLElement && tocTargets.includes(target)) {
			setActiveSection(target.id);
		}
	});

	const copyButtons = document.querySelectorAll<HTMLButtonElement>("[data-copy-code]");
	copyButtons.forEach((button) => {
		button.addEventListener("click", async () => {
			const figure = button.closest("figure");
			const code = figure?.querySelector("pre code");
			const status = figure?.querySelector("[data-copy-status]");
			if (!(code instanceof HTMLElement) || !(status instanceof HTMLElement)) {
				return;
			}

			try {
				await navigator.clipboard.writeText(code.textContent ?? "");
				button.classList.add("is-copied");
				button.textContent = "Copied";
				status.textContent = "Code copied to clipboard.";
				status.classList.remove("is-visible");
			} catch {
				status.textContent = "Copy unavailable. Select the code and copy it manually.";
				status.classList.add("is-visible");
				return;
			}

			window.setTimeout(() => {
				button.classList.remove("is-copied");
				button.textContent = "Copy";
				status.textContent = "";
			}, 1800);
		});
	});
</script>
