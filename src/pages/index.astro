---
import HeroWall from "../components/HeroWall.astro";
import { HERO_WALL_AVIF_SRC } from "../lib/hero-wall";
import Root from "../layouts/Root.astro";
---

<Root
	title="Platinum Gold — Binding of Isaac item API"
	description="Make the first Binding of Isaac item API call without leaking the key."
	preloadDisplayFont={true}
>
	<a
		slot="skip"
		href="#content"
		class="bg-primary text-on-primary font-sans font-semibold absolute start-2 top-0 z-50 min-h-11 rounded-sm px-3 py-3 -translate-y-full focus-visible:translate-y-12"
		>Skip to content</a
	>
	<main id="content" tabindex="-1">
		<div data-hero-pin>
			<section
				data-hero
				class="scheme-dark relative min-h-[calc(100dvh-var(--pg-header-height))] overflow-hidden text-on-surface"
			>
				<div data-hero-wall class="absolute inset-0">
					<HeroWall fallback="wide" imgClass="absolute inset-0 size-full object-cover object-center" />
					<div data-hero-shade aria-hidden="true"></div>
				</div>
				<div
					class="from-surface via-surface/55 pointer-events-none absolute inset-0 bg-linear-to-t to-transparent"
				>
				</div>
				<div
					data-hero-overlay
					class="relative flex min-h-[calc(100dvh-var(--pg-header-height))] flex-col justify-end px-margin pt-xl pb-[max(var(--spacing-xxl),env(safe-area-inset-bottom,0px))]"
				>
					<div data-hero-plane>
						<h1 translate="no">Platinum Gold</h1>
						<p class="text-body-lg mt-md max-w-[65ch] tracking-[0.01em] text-pretty">
							Every Binding of Isaac item. One read-only catalog. Built for frontend developers who need
							the data without dragging a secret into the browser.
						</p>
						<div class="hero-actions">
							<a href="/getting-started" class="hero-primary">Enter the guide</a>
							<button class="request-access-trigger" type="button" data-placement="hero" data-open-request-access>
								Request API access
							</button>
							<a href="https://platinum-gold-backend.vercel.app/docs" class="hero-secondary">
								Open API reference
							</a>
						</div>
						<ul class="hero-facts" aria-label="API summary">
							<li><strong>REST</strong><span>read only</span></li>
							<li><strong>/v1</strong><span>stable contract</span></li>
							<li><strong>JSON</strong><span>camelCase wire</span></li>
						</ul>
					</div>
				</div>
			</section>
		</div>

		<section
			id="first-call"
			class="first-call px-margin py-xxl"
			tabindex="-1"
			style={`--heroWall: url("${HERO_WALL_AVIF_SRC}")`}
		>
			<div class="first-call-sheet">
				<div class="first-call-copy">
					<h2>The first call</h2>
					<ol class="mt-lg list-decimal space-y-lg ps-lg text-pretty tabular-nums">
						<li>
							Send <code>X-API-Key</code> on every <code>/v1</code> request. Missing or
							invalid returns 401. A key without <code>api:access</code> returns 403.
						</li>
						<li>
							Hit <code>GET /v1/items</code> for a list, or
							{" "}<code>GET /v1/items/{`{gameId}`}</code> for one item.
						</li>
						<li>
							Keep the production key off the public bundle. Proxy it. Never
							<code>VITE_API_KEY</code> in the browser.
						</li>
					</ol>
					<a href="/getting-started" class="first-call-link">Follow the field guide</a>
				</div>
				<figure class="first-call-request">
					<figcaption>Safe server request</figcaption>
					<pre tabindex="0" aria-label="Safe server request example"><code>GET /v1/items?type=passive HTTP/1.1
Host: platinum-gold-backend.vercel.app
X-API-Key: ••••••••••••
Accept: application/json</code></pre>
				</figure>
			</div>
		</section>
	</main>
</Root>

<style>
	@property --hero-p {
		syntax: "<number>";
		inherits: true;
		initial-value: 0;
	}

	@property --spot-x {
		syntax: "<percentage>";
		inherits: true;
		initial-value: 52%;
	}

	@property --spot-y {
		syntax: "<percentage>";
		inherits: true;
		initial-value: 32%;
	}

	@property --spot-w {
		syntax: "<length>";
		inherits: true;
		initial-value: 14vmin;
	}

	@property --spot-h {
		syntax: "<length>";
		inherits: true;
		initial-value: 22vmin;
	}

	@property --tilt-x {
		syntax: "<angle>";
		inherits: true;
		initial-value: 0deg;
	}

	@property --tilt-y {
		syntax: "<angle>";
		inherits: true;
		initial-value: 0deg;
	}

	[data-hero] {
		--spot-x: 52%;
		--spot-y: 32%;
		--spot-w: 24vmin;
		--spot-h: 34vmin;
		--hero-p: 0;
		--tilt-x: 0deg;
		--tilt-y: 0deg;
		transition:
			--spot-x 0.45s cubic-bezier(0.22, 1, 0.36, 1),
			--spot-y 0.45s cubic-bezier(0.22, 1, 0.36, 1),
			--spot-w 0.4s cubic-bezier(0.22, 1, 0.36, 1),
			--spot-h 0.4s cubic-bezier(0.22, 1, 0.36, 1);
	}

	[data-hero]::after {
		content: "";
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: repeating-linear-gradient(
			0deg,
			transparent 0 3px,
			oklch(0.02 0.01 45 / 0.08) 3px 4px
		);
		mix-blend-mode: multiply;
	}

	[data-hero]:has(a:hover),
	[data-hero]:has(a:focus-visible) {
		--spot-w: 34vmin;
		--spot-h: 48vmin;
	}

	[data-hero] h1 {
		font-family: var(--font-display);
		font-size: clamp(3.5rem, 11vw, 9rem);
		line-height: 1.05;
		letter-spacing: var(--text-display--letter-spacing);
		font-weight: 400;
		font-synthesis: none;
		font-size-adjust: 0.5;
	}

	.first-call-request figcaption {
		font-size: var(--text-label-md);
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-md);
		margin-block-start: var(--spacing-lg);
	}

	.hero-primary,
	.hero-secondary,
	.first-call-link {
		display: inline-flex;
		min-block-size: 3rem;
		align-items: center;
		justify-content: center;
		border: 1px solid var(--color-primary);
		border-radius: var(--radius-sm);
		padding-inline: var(--spacing-xl);
		font-weight: 600;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
	}

	.hero-primary {
		background: var(--color-primary);
		color: var(--color-on-primary);
		box-shadow: 0.3rem 0.35rem 0 oklch(0.07 0.02 50 / 0.7);
	}

	.hero-primary:hover {
		background: var(--color-primary-hover);
		color: var(--color-on-primary);
	}

	.hero-primary:active,
	.first-call-link:active {
		box-shadow: 0.1rem 0.12rem 0 var(--pg-paper-shadow);
		transform: translate(0.18rem, 0.2rem);
	}

	.hero-secondary {
		background: oklch(0.12 0.02 50 / 0.72);
		color: var(--color-on-surface);
	}

	.hero-secondary:hover {
		color: var(--color-primary-hover);
	}

	.hero-facts {
		display: flex;
		max-inline-size: 42rem;
		flex-wrap: wrap;
		gap: var(--spacing-md) var(--spacing-xl);
		margin-block-start: var(--spacing-xl);
		padding: 0;
		list-style: none;
	}

	.hero-facts li {
		display: grid;
		gap: 0.1rem;
		border-inline-start: 2px solid var(--color-tertiary);
		padding-inline-start: var(--spacing-sm);
	}

	.hero-facts strong {
		font-family: var(--font-mono);
		font-size: var(--text-body-sm);
		color: var(--color-on-surface);
	}

	.hero-facts span {
		font-size: var(--text-body-sm);
		color: var(--color-on-surface-muted);
	}

	.first-call {
		position: relative;
		scroll-margin-block-start: calc(var(--pg-header-height) + var(--spacing-lg));
		background:
			linear-gradient(oklch(0.09 0.02 50 / 0.76), oklch(0.09 0.02 50 / 0.92)),
			var(--heroWall) center 38% / cover;
	}

	.first-call-sheet {
		display: grid;
		max-inline-size: 76rem;
		grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.9fr);
		gap: clamp(var(--spacing-xl), 6vw, 5rem);
		margin-inline: auto;
		border: 2px solid var(--color-paper-border);
		background:
			repeating-linear-gradient(2deg, transparent 0 2.5rem, oklch(0.5 0.05 65 / 0.08) 2.5rem calc(2.5rem + 1px)),
			var(--color-paper);
		color: var(--color-ink);
		padding: clamp(var(--spacing-lg), 5vw, 4.5rem);
		box-shadow: 0.75rem 0.9rem 0 var(--pg-paper-shadow);
		transform: rotate(-0.25deg);
	}

	.first-call-sheet h2 {
		font-family: var(--font-display);
		font-size: clamp(2.75rem, 7vw, 5rem);
		font-size-adjust: 0.5;
		font-weight: 400;
		letter-spacing: 0.02em;
	}

	.first-call-request figcaption {
		color: var(--color-ink-muted);
	}

	.first-call-copy code {
		background: color-mix(in oklch, var(--color-paper-border) 22%, transparent);
		color: var(--color-ink);
	}

	.first-call-link {
		margin-block-start: var(--spacing-xl);
		border-color: var(--color-ink);
		background: var(--color-ink);
		color: var(--color-paper-raised);
		box-shadow: 0.25rem 0.3rem 0 var(--color-paper-border);
	}

	.first-call-link:hover {
		background: var(--color-ink-link);
		color: var(--color-paper-raised);
	}

	.first-call-link:focus-visible {
		outline-color: var(--color-ink-link);
		outline-width: 3px;
	}

	.first-call-request {
		align-self: center;
		min-inline-size: 0;
	}

	.first-call-request pre {
		margin-block-start: var(--spacing-sm);
		max-inline-size: 100%;
		overflow-x: auto;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		box-shadow: 0.35rem 0.4rem 0 color-mix(in oklch, var(--color-paper-border) 72%, transparent);
	}

	.first-call-request pre code {
		color: var(--color-on-surface);
	}

	[data-hero-shade] {
		pointer-events: none;
		position: absolute;
		inset: 0;
		background: color-mix(in oklch, var(--color-surface) 72%, transparent);
		-webkit-mask-image: radial-gradient(
			ellipse var(--spot-w) var(--spot-h) at var(--spot-x) var(--spot-y),
			transparent 0%,
			transparent 28%,
			black 62%
		);
		mask-image: radial-gradient(
			ellipse var(--spot-w) var(--spot-h) at var(--spot-x) var(--spot-y),
			transparent 0%,
			transparent 28%,
			black 62%
		);
		-webkit-mask-repeat: no-repeat;
		mask-repeat: no-repeat;
	}

	@media (prefers-reduced-motion: reduce) {
		[data-hero] {
			transition: none;
		}

		[data-hero-shade] {
			display: none;
		}

		.hero-primary:active,
		.first-call-link:active {
			transform: none;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		@keyframes pg-tear-form {
			from {
				--spot-w: 0px;
				--spot-h: 0px;
			}
		}

		[data-hero-pin] {
			block-size: 140vh;
		}

		[data-hero] {
			position: sticky;
			inset-block-start: var(--pg-header-height);
			animation: pg-tear-form 0.65s cubic-bezier(0.16, 1, 0.3, 1) backwards;
		}

		[data-hero] a {
			transition:
				background-color 0.15s cubic-bezier(0.16, 1, 0.3, 1),
				border-color 0.15s cubic-bezier(0.16, 1, 0.3, 1),
				color 0.15s cubic-bezier(0.16, 1, 0.3, 1),
				box-shadow 0.15s cubic-bezier(0.16, 1, 0.3, 1),
				transform 0.15s cubic-bezier(0.16, 1, 0.3, 1);
		}

		[data-hero-wall] {
			transform: scale(calc(1 + 0.08 * var(--hero-p)))
				translateY(calc(var(--hero-p) * -6%));
			opacity: calc(1 - var(--hero-p));
		}

		[data-hero-overlay] {
			opacity: max(0, calc(1 - var(--hero-p) * 1.7));
			transform: translateY(calc(var(--hero-p) * -1.25rem));
		}

		[data-hero-overlay][inert] {
			pointer-events: none;
		}

		[data-hero-plane] {
			transform: perspective(60rem) rotateX(var(--tilt-y)) rotateY(var(--tilt-x));
			transform-origin: 50% 100%;
			transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
		}
	}

	@media (max-width: 48rem) {
		[data-hero] h1 {
			font-size: clamp(2.75rem, 14vw, 5rem);
			overflow-wrap: normal;
			word-break: normal;
		}

		.hero-actions {
			display: grid;
		}

		.hero-primary,
		.hero-secondary {
			inline-size: 100%;
		}

		.first-call-sheet {
			grid-template-columns: minmax(0, 1fr);
			transform: none;
		}
	}

	@media (prefers-reduced-transparency: reduce) {
		.hero-secondary {
			background: var(--color-surface);
		}
	}
</style>

<script>
	const stage = document.querySelector("[data-hero]");
	const motion = window.matchMedia("(prefers-reduced-motion: reduce)");

	let stop = (): void => {};

	async function sync(): Promise<void> {
		stop();
		stop = (): void => {};
		if (!(stage instanceof HTMLElement)) {
			return;
		}
		if (motion.matches) {
			return;
		}
		const scene = await import("../scripts/hero-wall.ts");
		stop = scene.mountHeroWall(stage);
	}

	motion.addEventListener("change", () => {
		void sync();
	});
	void sync();
</script>
