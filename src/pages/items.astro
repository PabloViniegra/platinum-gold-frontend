---
import HeroWall from "../components/HeroWall.astro";
import ItemExplorer from "../components/ItemExplorer";
import Root from "../layouts/Root.astro";
import "../components/item-explorer.css";
---

<Root
	title="Items in the wild — Platinum Gold"
	description="Filter, sort, and paginate the Platinum Gold item API through a secure server-side proxy."
	preloadDisplayFont={true}
>
	<link slot="head" rel="preconnect" href="https://raw.githubusercontent.com" crossorigin />
	<a slot="skip" class="items-skip" href="#items-content">Skip to item example</a>
	<div class="items-scene" aria-hidden="true">
		<HeroWall fallback="narrow" />
	</div>
	<main id="items-content" class="items-shell px-margin py-xxl" tabindex="-1">
		<nav class="items-breadcrumb text-body-sm" aria-label="Breadcrumb">
			<a href="/" translate="no">Platinum Gold</a>
			<span aria-hidden="true">/</span>
			<span aria-current="page">Live example</span>
		</nav>

		<header class="items-header">
			<h1>Items in the wild</h1>
			<p class="text-body-lg text-pretty">
				A working <code>GET /v1/items</code> call through <code>/api/items</code>.
				The browser never receives the API key.
			</p>
		</header>

		<article class="items-sheet">
			<ItemExplorer client:only="react">
				<div class="item-loading" aria-busy="true">
					<p>Loading GET /v1/items…</p>
					<ul class="item-grid" aria-hidden="true">
						{Array.from({ length: 12 }, () => (
							<li class="item-card-skeleton">
								<div class="item-image item-skeleton-block"></div>
								<div class="item-skeleton-line item-skeleton-title"></div>
							</li>
						))}
					</ul>
				</div>
			</ItemExplorer>
		</article>
	</main>
	<footer class="items-footer px-margin pb-xxl" aria-label="Example page footer">
		<div>
			<span>Platinum Gold API example</span>
			<div class="items-footer-links">
				<a href="/getting-started">Read the integration guide</a>
				<a href="https://tboi-api.pabloviniegra.dev/openapi.json">OpenAPI</a>
			</div>
		</div>
	</footer>
</Root>

<style is:global>
	html[data-page="items"] {
		scroll-padding-block-start: calc(var(--pg-header-height) + var(--spacing-md));
	}
</style>

<style>
	.items-skip {
		position: absolute;
		inset-block-start: var(--spacing-sm);
		inset-inline-start: var(--spacing-sm);
		z-index: 50;
		transform: translateY(calc(-100% - var(--spacing-sm)));
		border-radius: var(--radius-sm);
		background: var(--color-primary);
		color: var(--color-on-primary);
		padding: var(--spacing-sm) var(--spacing-md);
		font-weight: 600;
	}

	.items-skip:focus-visible {
		transform: translateY(0);
	}

	.items-scene {
		position: fixed;
		inset: var(--pg-header-height) 0 0;
		z-index: 0;
		overflow: hidden;
		pointer-events: none;
		filter: saturate(0.65) contrast(1.1);
	}

	.items-scene img {
		position: absolute;
		inset: 0;
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
		object-position: center 20%;
	}

	.items-scene::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(oklch(0.08 0.018 48 / 0.86), oklch(0.08 0.018 48 / 0.96));
	}

	.items-shell,
	.items-footer {
		position: relative;
		z-index: 1;
		max-inline-size: 92rem;
		margin-inline: auto;
	}

	.items-breadcrumb {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--spacing-sm);
		color: var(--color-on-surface-muted);
	}

	.items-header {
		max-inline-size: 54rem;
		padding-block: var(--spacing-xl) var(--spacing-lg);
	}

	.items-header h1 {
		font-family: var(--font-display);
		font-size: clamp(2.5rem, 6vw, 4rem);
		font-size-adjust: 0.5;
		font-weight: 400;
		line-height: 1;
		letter-spacing: 0.02em;
		text-shadow: 0.2rem 0.25rem 0 oklch(0.05 0.015 45 / 0.75);
	}

	.items-header p {
		max-inline-size: 54ch;
		margin-block-start: var(--spacing-md);
		color: var(--color-on-surface-muted);
	}

	.items-sheet {
		position: relative;
		min-block-size: 52rem;
		border: 2px solid var(--color-paper-border);
		background:
			repeating-linear-gradient(1deg, transparent 0 3.25rem, oklch(0.48 0.055 65 / 0.06) 3.25rem calc(3.25rem + 1px)),
			var(--color-paper);
		color: var(--color-ink);
		padding: clamp(var(--spacing-lg), 4vw, 3rem);
		box-shadow: 0.8rem 0.95rem 0 var(--pg-paper-shadow);
	}

	.items-sheet::before,
	.items-sheet::after {
		content: "";
		position: absolute;
		z-index: 1;
		inline-size: 4.5rem;
		block-size: 1.1rem;
		background: oklch(0.79 0.045 77 / 0.78);
		box-shadow: 0 1px 0 oklch(0.45 0.04 60 / 0.35);
		transform: rotate(-39deg);
	}

	.items-sheet::before {
		inset-block-start: 1rem;
		inset-inline-start: -1.75rem;
	}

	.items-sheet::after {
		inset-block-end: 1rem;
		inset-inline-end: -1.75rem;
	}

	.items-footer {
		padding-block-start: var(--spacing-xxl);
	}

	.items-footer > div {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--spacing-md);
		border-block-start: 1px solid var(--color-border);
		padding-block-start: var(--spacing-lg);
		color: var(--color-on-surface-muted);
		font-size: var(--text-body-sm);
	}

	.items-footer-links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-md) var(--spacing-lg);
	}

	@media (max-width: 48rem) {
		.items-sheet {
			min-block-size: 72rem;
		}

		.items-shell {
			padding-block-start: var(--spacing-md);
		}

		.items-header {
			padding-block: var(--spacing-md) var(--spacing-sm);
		}

		.items-sheet {
			padding-inline: var(--spacing-md);
			box-shadow: 0.4rem 0.5rem 0 var(--pg-paper-shadow);
		}

		.items-sheet::before,
		.items-sheet::after {
			display: none;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.items-skip {
			transition: transform 150ms cubic-bezier(0.16, 1, 0.3, 1);
		}
	}
</style>
